// Assistant IA : état partagé du volet (conversation, état du backend),
// gardé quand le volet se ferme et se rouvre. La conversation se relit
// depuis le backend (AITranscript) à l'ouverture du volet et sur ai:reset
// (classeur ouvert, nouveau ou fermé, conversation gardée dans le classeur).
import { DocumentService } from '#bindings/internal/bridge/index.js';
import type { AIStatus } from '#bindings/internal/bridge/models.js';
import { Events } from '@wailsio/runtime';
import { modalOpen } from '#lib/ui/focus.js';
import { applyEvent, dropRun, endRun, failedBeforeReply, markUndone, maxRun, reopenRun, replay, startRun, type ChatContext, type ChatEvent, type Item, type LogEntry } from './chat';

export const chat = $state<{
	items: Item[];
	busy: boolean;
	draft: string;
	error: string;
	status: AIStatus | null;
	/** Volet ouvert (bouton « Assistant ✦ », Alt+I, clic droit). */
	open: boolean;
	/** Demande de focus sur la zone de saisie (incrémentée). */
	focus: number;
	/** Messages envoyés, pour la flèche haut. */
	sent: string[];
	/** Ouvert depuis une boîte modale : posé au-dessus d'elle (comme l'aide), et utilisable. */
	over: boolean;
}>({
	items: [],
	busy: false,
	draft: '',
	error: '',
	status: null,
	open: false,
	focus: 0,
	sent: [],
	over: false
});

let run = 0;
let listening = false;

function listen() {
	if (listening) return;
	listening = true;
	try {
		Events.On('ai:event', (e: { data: ChatEvent }) => {
			const ev = e.data;
			// Usage du tour : le coût affiché suit sans attendre la fin de la réponse.
			if (ev.kind === 'usage' && ev.usage && chat.status?.usage) {
				chat.status.usage = { ...chat.status.usage, cost: chat.status.usage.cost + (ev.usage.cost || 0) };
			}
			chat.items = applyEvent(chat.items, ev);
		});
		Events.On('ai:reset', () => {
			load();
		});
	} catch {
		// Pas de pont (tests).
	}
}

/** Relit l'état de l'assistant (réglages, fournisseurs, clés, coût). */
export async function refreshStatus() {
	try {
		chat.status = await DocumentService.AIState();
	} catch {
		// Pas de pont (tests).
	}
}

/** Relit l'état et la conversation (ouverture du volet, ai:reset). */
export async function load() {
	listen();
	await refreshStatus();
	try {
		const log = ((await DocumentService.AITranscript()) ?? []) as LogEntry[];
		// Une réponse en cours dans ce volet garde son affichage (ses évènements arrivent).
		if (chat.busy) return;
		chat.items = replay(log, !!chat.status?.busy);
		run = Math.max(run, maxRun(chat.items));
		chat.sent = chat.items.filter((it) => it.role === 'user').map((it) => (it as { text: string }).text);
	} catch {
		// Backend sans conversation à relire : l'affichage reste.
	}
}

/** Envoie un message avec ce que l'utilisateur regarde ; la réponse arrive par ai:event. */
export async function send(text: string, view: ChatContext) {
	text = text.trim();
	if (!text || chat.busy) return;
	listen();
	const r = ++run;
	chat.items = startRun(chat.items, r, text);
	chat.sent = [...chat.sent.slice(-49), text];
	chat.draft = '';
	chat.error = '';
	chat.busy = true;
	let error = '';
	try {
		await DocumentService.AISend(r, text, view);
	} catch (e) {
		error = errorText(e);
	} finally {
		chat.busy = false;
	}
	// Le modèle n'a pas reçu le message (erreur ou arrêt au premier tour) : il
	// revient dans la zone de saisie (le backend l'a retiré de la conversation),
	// l'erreur éventuelle s'affiche au-dessus.
	if (failedBeforeReply(chat.items, r, !!error)) {
		chat.items = dropRun(chat.items, r);
		chat.error = error;
		if (!chat.draft) chat.draft = text;
	} else {
		chat.items = endRun(chat.items, r, error || undefined);
	}
	await refreshStatus();
}

/**
 * Reprend la réponse r là où elle s'est arrêtée (« Réessayer » après une
 * erreur en cours de réponse, « Continuer ») : pas de nouveau message, la
 * suite s'ajoute à la même réponse, qui reste annulable d'un coup.
 */
export async function resume(r: number) {
	if (chat.busy) return;
	listen();
	chat.items = reopenRun(chat.items, r);
	chat.error = '';
	chat.busy = true;
	let error = '';
	try {
		await DocumentService.AIResume(r);
	} catch (e) {
		error = errorText(e);
	} finally {
		chat.busy = false;
	}
	chat.items = endRun(chat.items, r, error || undefined);
	await refreshStatus();
}

/** Interrompt la réponse en cours. */
export function stop() {
	DocumentService.AIStop().catch(() => {});
}

/** Annule les modifications d'une réponse ; lève l'erreur du backend (d'autres modifications ont suivi…). */
export async function undoRun(r: number) {
	const st = await DocumentService.AIUndoRun(r);
	chat.items = markUndone(chat.items, r);
	return st;
}

/** Nouvelle conversation. */
export async function reset() {
	if (chat.busy) return;
	await DocumentService.AIReset();
	chat.items = [];
	chat.error = '';
	await refreshStatus();
}

/** Ouvre le volet et met le curseur dans la zone de saisie. */
export function openAssistant() {
	chat.over = false;
	chat.open = true;
	chat.focus++;
}

/**
 * Ouvre le volet avec une demande à compléter (bouton « Rédiger avec
 * l'assistant » d'une boîte) : rien n'est envoyé, la personne relit et
 * envoie. Depuis une boîte modale, le volet passe au-dessus d'elle.
 */
export function askAssistant(prompt: string) {
	chat.draft = prompt;
	chat.over = modalOpen();
	chat.open = true;
	chat.focus++;
}

/** Conversation de la liste (bridge.AIConversation) ; id 0 : celle en cours. */
export interface Conversation {
	id: number;
	title: string;
	updated: string;
	current: boolean;
}

/** Conversations du classeur : celle en cours, puis les autres. */
export async function conversations(): Promise<Conversation[]> {
	return ((await DocumentService.AIConversations()) ?? []) as Conversation[];
}

/** Nouvelle conversation : l'actuelle reste dans la liste. */
export async function newConversation() {
	if (chat.busy) return;
	await DocumentService.AINewConversation();
	chat.items = [];
	chat.error = '';
	await refreshStatus();
}

/** Reprend une conversation de la liste. */
export async function openConversation(id: number) {
	if (chat.busy) return;
	await DocumentService.AIOpenConversation(id);
	chat.error = '';
	await load();
}

/** Supprime une conversation de la liste (0 : vide celle en cours). */
export async function deleteConversation(id: number) {
	if (chat.busy) return;
	await DocumentService.AIDeleteConversation(id);
	if (id === 0) chat.items = [];
	await refreshStatus();
}
