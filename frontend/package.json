{
  "name": "lattis-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "build:web": "vite build --mode web",
    "dev:web": "vite dev --mode web",
    "preview": "vite preview",
    "check": "node scripts/i18n-types.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "i18n:types": "node scripts/i18n-types.mjs",
    "test": "vitest run",
		"e2e": "npm run build:web && playwright test",
		"e2e:run": "playwright test",
    "prepare": "svelte-kit sync || echo \"\""
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@wailsio/runtime": "^3.0.0-beta.30",
    "qrcode-generator": "^2.0.4",
    "quill": "^2.0.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#bindings/*": "./bindings/github.com/lalamefine/lattis/*"
  }
}
