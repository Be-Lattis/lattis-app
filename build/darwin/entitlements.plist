<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Droits de Lattis signé avec le « hardened runtime » (Developer ID,
  notarisation). Hors bac à sable (pas de com.apple.security.app-sandbox) :
  les droits réseau ci-dessous sont sans effet aujourd'hui et documentent les
  besoins (sources externes, serveur MCP local) si le bac à sable vient un jour.
  Aucun droit d'exécution de code dynamique : le moteur JavaScript tourne dans
  les processus WebKit du système, pas dans celui de Lattis.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
