        PublisherName="CN=Lattis"
        PublisherDisplayName="Lattis"
        Version="0.1.0.0"
        PackageDescription="Tableur relationnel local-first">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
